{
  "name": "game-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:ensure && npm run db:migrate:deploy && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:setup": "npm run db:ensure && npm run db:migrate:deploy",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:with-db": "npm run build:client && npm run build:server && npm run db:generate",
    "clean": "rm -rf dist temp.* *.temp.*",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "preview": "vite preview --config client/vite.config.ts",
    "db:ensure": "bash scripts/ensure-postgres.sh && bash scripts/ensure-database.sh",
    "db:generate": "prisma generate --schema=server/src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=server/src/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=server/src/prisma/schema.prisma",
    "db:push": "prisma db push --schema=server/src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=server/src/prisma/schema.prisma",
    "db:migrate:create": "prisma migrate dev --create-only --schema=server/src/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema=server/src/prisma/schema.prisma",
    "db:migrate:resolve": "prisma migrate resolve --schema=server/src/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=server/src/prisma/schema.prisma",
    "postgres:shared-status": "docker ps -f name=sage-shared-dev-postgres",
    "postgres:shared-stop": "docker stop sage-shared-dev-postgres",
    "postgres:shared-logs": "docker logs sage-shared-dev-postgres -f",
    "deploy": "node scripts/setup-deployment.js && npm run build && fly deploy",
    "deploy:force-setup": "FORCE_FLY_SETUP=1 npm run deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx server/src/games/simulate-cli.ts"
  },
  "dependencies": {
    "@emeraldpay/hashicon-react": "^0.5.2",
    "@prisma/client": "^6.13.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "nanoid": "^5.1.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.13.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/nanoid": "^2.1.0",
    "@types/node": "^20.10.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^3.2.7"
  }
}
